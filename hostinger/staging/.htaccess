# SPA must use index.html before Hostinger’s default index.php (delete stray index.php if this still fails).

<IfModule mod_dir.c>
    DirectoryIndex index.html index.htm
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Root URL only: Apache treats "/" as the directory public_html; the rule below
    # [ -f / -d ] would match that directory and stop, then DirectoryIndex may pick
    # index.php or another default instead of this SPA's index.html. Force the shell first.
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^$ index.html [L]

    # Serve real files and directories as-is
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # React Router: send non-file routes to index.html
    RewriteRule ^ index.html [L]
</IfModule>
