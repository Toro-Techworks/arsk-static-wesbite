# Static React SPA (Vite). LiteSpeed on Hostinger reads this like Apache mod_rewrite.

<IfModule mod_dir.c>
    DirectoryIndex index.html index.htm
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Hostinger default / placeholder — serve the built SPA instead of PHP
    RewriteRule ^index\.php$ index.html [L]

    # Document root: "/" maps to this folder; [-d] shortcut must not run before we
    # map the homepage to index.html (otherwise DirectoryIndex may pick index.php).
    RewriteCond %{REQUEST_URI} ^/?$
    RewriteRule ^$ index.html [L]

    # Existing files (assets, favicons, manifest, etc.)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Real directories only (e.g. rare static subfolders). Skip implicit "/" — handled above.
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !^/?$
    RewriteRule ^ - [L]

    # Client-side routes
    RewriteRule ^ index.html [L]
</IfModule>
